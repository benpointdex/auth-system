# ============================================================
#  .env.example
#  Copy this file to `.env` and fill in the secrets.
#  The `.env` file must NEVER be committed to source control.
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=authdb
DB_USER=authuser
DB_PASSWORD=changeme         # ⚠️  change in production!

# ── JWT ─────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ISSUER=api.substring.com
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=86400
JWT_REFRESH_COOKIE_NAME=refreshToken
JWT_COOKIE_SECURE=true
JWT_COOKIE_HTTP_ONLY=true
JWT_COOKIE_SAME_SITE=lax
JWT_COOKIE_DOMAIN=localhost

# ── Google OAuth2 ────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── CORS / frontend ──────────────────────────────────────────
FRONT_END_URL=http://localhost:3000
FRONT_END_SUCCESS_REDIRECT=http://localhost:3000/oauth2/success
FRONT_END_FAILURE_REDIRECT=http://localhost:3000/oauth2/failure

# ── Server ───────────────────────────────────────────────────
SERVER_PORT=8081
